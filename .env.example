# --- Database ---
# Works with any Postgres-protocol endpoint: local docker, Neon, Supabase, RDS.
# We use `postgres-js` (the standard Postgres wire protocol) for both dev and prod.
POSTGRES_URL=postgresql://user:password@localhost:5432/nextep

# --- App ---
BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_me_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Create matching products in Stripe (price IDs go here).
STRIPE_PRICE_ID_FREE=
STRIPE_PRICE_ID_PRO=

# --- AI (Vercel AI SDK) ---
ANTHROPIC_API_KEY=sk-ant-replace_me
OPENAI_API_KEY=sk-replace_me

# --- Email (Resend) ---
RESEND_API_KEY=re_replace_me

# --- File storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=vercel_blob_replace_me

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Realtime (Liveblocks) ---
LIVEBLOCKS_SECRET_KEY=sk_dev_replace_me
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=pk_dev_replace_me

# --- Background jobs (Inngest) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=