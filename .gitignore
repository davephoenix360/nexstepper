# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.vscode

# Docker
postgres_data/
.env*.local

# Local dev artifacts
*.local.log
dev-server.*.log
dev*.log
*.tsbuildinfo

# CodeRabbit review output (transient — the launcher writes here
# when invoked with -OutFile. Safe to regenerate any time.)
.cr-review.txt

# Dev server logs (transient — written by background `pnpm dev`)
*.dev-server.log

# Playwright CLI browser cache (transient — recreated on every open)
.playwright-cli/

# HuggingFace transformers cache (downloaded by scripts that exercise
# the semantic-similarity path of the ATS scoring engine — e.g.
# scripts/smoke-semantic.mjs. ~1.5 GB; never commit.)
.cache/

# Output artifacts (PDFs, PNGs, screenshots, etc. — never commit
# generated deliverables, only the source scripts that produce them)
output/

# Mavis agent credentials (never commit; the .mavis-agent.md file
# holds the test account email + password used to drive the dev server
# for end-to-end verification).
.mavis-agent.md
.mavis-agent.local.md

# Mavis agent skills directory (per-machine tooling, not part of the
# Nexstepper repo — it lives under C:/Users/.../.mavis/agents/* and
# happens to show up in the Nexstepper workspace via the agent context).
.agents/
.env.local

# PostHog wizard transient artifacts (skills + cache dropped into the
# workspace by the PostHog AI Observability setup wizard). Safe to
# regenerate by re-running the wizard. Never commit.
.claude/
.posthog-wizard-cache/

# Disposable scratch / "trash" files. Local safety policy blocks
# Remove-Item, so the working pattern is to move stale or experimental
# files into .trash/ instead of deleting them outright.
.trash/
*.trash
